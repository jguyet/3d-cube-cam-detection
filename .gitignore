# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local prototype harnesses
_*.mjs

_*.ts

/public/backgrounds/
/public/models/*.onnx

# generated datasets (large, regenerable headlessly)
/dataset-*/

# eval harness cache
/.evalcache/

# training artifacts (root)
/best.pt
/cube_detector.onnx
/cube_detector.onnx.data

# 3D t-shirt mockup assets (copied from linepicplus/3d-mockups)
/public/mockup/
/public/dataset-tests/
/dataset-review/
